{
  "name": "book-it",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chrisoakman/chessboardjs": "^1.0.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "browserify-zlib": "^0.2.0",
    "chess.js": "^1.0.0-beta.7",
    "chessboard-arrows": "^1.0.2",
    "dexie": "^3.2.4",
    "eslint": "^8.3.0",
    "file-saver": "^2.0.5",
    "install": "^0.13.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^29.7.0",
    "jest-resolve": "^28.1.3",
    "jest-watch-typeahead": "^1.0.0",
    "jszip": "^3.10.1",
    "pgn-parser": "^2.2.0",
    "primeflex": "^3.3.1",
    "primereact": "^10.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router": "^7.0.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "jest .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(scss|sass|css)$": "identity-obj-proxy"
    },
    "verbose": true,
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest-setup.js"
    ],
    "testPathIgnorePatterns": [
      "scripts"
    ],
    "collectCoverageFrom": [
      "src/**",
      "!src/index.js",
      "!src/storage.js",
      "!src/worker.js"
    ],
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "lines": 10
      }
    },
    "coverageReporters": [
      "lcov",
      "text",
      "json-summary"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "devDependencies": {
    "@babel/plugin-syntax-optional-chaining-assign": "^7.23.7",
    "@storybook/addon-docs": "^10.0.2",
    "@storybook/addon-onboarding": "^10.0.2",
    "@storybook/addon-links": "^10.0.2",
    "@storybook/react-vite": "^10.0.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/create-react-app": "^2.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/pgn-parser": "^2.1.3",
    "babel-preset-react-app": "^10.1.0",
    "child_process": "^1.0.2",
    "fake-indexeddb": "^5.0.2",
    "identity-obj-proxy": "^3.0.0",
    "storybook": "^10.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^6.4.1"
  }
}
